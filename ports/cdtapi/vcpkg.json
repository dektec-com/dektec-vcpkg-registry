{
  "name": "cdtapi",
  "version": "6.14.11",
  "description": "Native open-source C API for DekTec SDI, DVB-ASI and SMPTE ST 2110 interfaces",
  "homepage": "https://github.com/dektec-com/cdtapi",
  "license": "BSD-3-Clause",
  "supports": "x64 & (windows | linux)",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "nmos": {
      "description": "The NMOS bridge of the AV FIFO, on dtnmos with its HTTP client and server",
      "dependencies": [
        {
          "name": "dtnmos",
          "features": [
            "curl",
            "server"
          ],
          "version>=": "0.5.2"
        }
      ]
    }
  }
}
